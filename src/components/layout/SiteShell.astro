---
import SiteHeader from './SiteHeader.astro';
import Footer from './Footer.astro';

interface Props {
  activePath: string;
}

const { activePath } = Astro.props;
---

<div class="site-shell">
  <SiteHeader activePath={activePath} />
  <main id="main-content" class="site-main">
    <slot />
  </main>
  <Footer />
</div>
