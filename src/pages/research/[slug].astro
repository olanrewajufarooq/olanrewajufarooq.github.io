---
import { getCollection, render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import projectsData from '../../data/research/projects.json';
import { buildMetadata, getCanonicalUrl } from '../../shared/content/metadata';

export async function getStaticPaths() {
  const themes = await getCollection('research');
  return themes.map((theme) => ({ params: { slug: theme.data.slug ?? theme.id.replace(/\.md$/, '') }, props: { theme } }));
}

const { theme } = Astro.props;
const { Content } = await render(theme);
const projects = projectsData.projects.filter((project) => theme.data.projectIds.includes(project.id));
const projectOverviews = projects.filter((project) => project.image);
const publications = (await getCollection('publications'))
  .filter((publication) => theme.data.publicationIds.includes(publication.data.id))
  .sort((a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title));
const statusLabel = theme.data.status === 'ongoing' ? 'Current' : 'Completed';
const publicationStatusLabel = (status: string) => ({ 'in-review': 'Under review', submitted: 'Submitted', accepted: 'Accepted', published: 'Published', 'in-draft': 'Draft' })[status] ?? status;
const imageWidths = [320, 480, 640, 768, 896, 1024];
const responsiveImage = (src: string) => {
  const match = src.match(/^(.*)-1024\.jpg$/);
  return match
    ? { src, srcset: imageWidths.map((width) => `${match[1]}-${width}.jpg ${width}w`).join(', ') }
    : { src, srcset: undefined };
};
const meta = buildMetadata({
  title: theme.data.title,
  description: theme.data.summary,
  canonical: getCanonicalUrl(`/research/${theme.data.slug ?? theme.id.replace(/\.md$/, '')}`),
  image: theme.data.coverImage ?? '/assets/images/me/headshot.png',
  ogType: 'article',
});
---

<ContentLayout title={meta.title} description={meta.description} activePath="/research" canonical={meta.canonical} ogImage={meta.openGraph.image}>
  <header class="page-intro page-intro--reading">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/research">Research</a><span aria-hidden="true">/</span><span>{theme.data.title}</span></nav>
    <p class="eyebrow">Research theme</p>
    <h1>{theme.data.title}</h1>
    <p>{theme.data.summary}</p>
    <div class="detail-header-meta" aria-label="Research metadata"><span>{theme.data.period}</span><span class="status-label">{statusLabel}</span><span>{theme.data.keywords.slice(0, 3).join(' · ')}</span></div>
  </header>
  <div class="detail-layout reading-page">
    <article class="detail-content"><Content /></article>
    <aside class="detail-aside" aria-label="Research theme details">
      <dl><dt>Keywords</dt><dd>{theme.data.keywords.join(', ')}</dd></dl>
      {projects.length > 0 && <dl><dt>Projects</dt><dd>{projects.map((project) => <div>{project.url ? <a href={project.url} target="_blank" rel="noreferrer">{project.title}</a> : project.title}</div>)}</dd></dl>}
      {theme.data.collaborators.length > 0 && <dl><dt>Collaborators</dt><dd>{theme.data.collaborators.map((collaborator) => <div>{collaborator.url ? <a href={collaborator.url} target="_blank" rel="noreferrer">{collaborator.name}</a> : collaborator.name}</div>)}</dd></dl>}
      {theme.data.advisors.length > 0 && <dl><dt>{theme.data.advisors.length > 1 ? 'Advisors' : 'Advisor'}</dt><dd>{theme.data.advisors.map((advisor) => <div>{advisor}</div>)}</dd></dl>}
      {theme.data.repositories.length > 0 && <dl><dt>Code</dt><dd>{theme.data.repositories.map((repository) => <div><a href={repository.url} target="_blank" rel="noreferrer">{repository.label}</a></div>)}</dd></dl>}
    </aside>
  </div>
  {projectOverviews.length > 0 && <section class="project-overviews section" aria-labelledby="project-overviews-title">
    <div class="section__heading"><p class="eyebrow">Project portfolio</p><div><h2 id="project-overviews-title">Projects within this theme.</h2><p>Selected work, methods, and outputs across the marine-robotics portfolio.</p></div></div>
    <div class="project-overviews__list">
      {projectOverviews.map((project, index) => <article class:list={['project-overview', index % 2 === 1 && 'project-overview--reverse']}>
        <img class="project-overview__image" src={project.image} alt={project.imageAlt ?? ''} loading="lazy" decoding="async" />
        <div class="project-overview__body">
          <div class="project-overview__meta meta"><span>{project.period}</span><span class="status-label">{project.status}</span></div>
          <h3>{project.title}</h3>
          <p>{project.summary}</p>
          {project.technologies.length > 0 && <p class="project-overview__technologies">{project.technologies.join(' · ')}</p>}
          {project.url && <a class="text-link" href={project.url} target="_blank" rel="noreferrer">{project.repositoryVisibility === 'public' ? 'View project ↗' : 'View publication ↗'}</a>}
        </div>
      </article>)}
    </div>
  </section>}
  {theme.data.gallery.length > 0 && <section class="research-gallery section" aria-labelledby="research-gallery-title">
    <div class="section__heading"><p class="eyebrow">Project record</p><div><h2 id="research-gallery-title">Design, build, and flight evidence.</h2><p>Selected documentation from the undergraduate prototype.</p></div></div>
    <div class="research-gallery__grid">
      {theme.data.gallery.map((image) => {
        const imageAttrs = responsiveImage(image.src);
        return <figure class="research-gallery__item">
          <img src={imageAttrs.src} srcset={imageAttrs.srcset} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw" alt={image.alt} loading="lazy" decoding="async" />
          {image.caption && <figcaption>{image.caption}</figcaption>}
        </figure>;
      })}
    </div>
  </section>}
  {publications.length > 0 && <section class="section" aria-labelledby="related-publications-title">
    <div class="section__heading"><p class="eyebrow">Publication record</p><div><h2 id="related-publications-title">Work from this theme.</h2><p>Published and submitted work connected to this research direction.</p></div></div>
    <div class="record-list">
      {publications.map((publication) => <article class="record">
        <div class="record__side"><span class="meta">{publication.data.year}</span><span class:list={['status-label', publication.data.status === 'published' ? 'status-label--published' : 'status-label--warm']}>{publicationStatusLabel(publication.data.status)}</span></div>
        <div class="record__content"><h3>{publication.data.title}</h3><p>{publication.data.authors.map((author) => author.name).join(', ')}</p><div class="record__details"><span>{publication.data.venue}</span><span class="record__actions">{publication.data.publisherUrl && <a href={publication.data.publisherUrl} target="_blank" rel="noreferrer">Publisher</a>}{publication.data.citation?.doi && <a href={`https://doi.org/${publication.data.citation.doi}`} target="_blank" rel="noreferrer">DOI</a>}{publication.data.bibtexPath && <a href={publication.data.bibtexPath} download>BibTeX</a>}</span></div></div>
      </article>)}
    </div>
  </section>}
</ContentLayout>
